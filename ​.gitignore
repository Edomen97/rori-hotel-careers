# ============================================
# RORI HOTEL CAREERS - .gitignore
# ============================================

# ============================================
# ENVIRONMENT & SECRETS
# ============================================
.env
.env.local
.env.*.local
*.env
secret_key.txt
config.local.py

# DO NOT IGNORE .env.example (Required for repository setup)
!.env.example

# ============================================
# PYTHON & FLASK
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
instance/
flask_session/
csrf_tokens/
.webassets-cache

# ============================================
# DATABASE
# ============================================
*.db
*.sqlite
*.sqlite3
instance/*.db
instance/*.sqlite
instance/*.sqlite3
*.pgdata
*.pgsql
*.mysql

# ============================================
# UPLOADS / MEDIA STORAGE
# ============================================
# Ignore user uploaded CVs/Resumes and Job images
static/uploads/*
uploads/*

# Keep upload directories in Git structure using .gitkeep
!static/uploads/.gitkeep
!static/uploads/cvs/
!static/uploads/cvs/.gitkeep
!static/uploads/jobs/
!static/uploads/jobs/.gitkeep

# ============================================
# LOGS & TEMP FILES
# ============================================
logs/
*.log
*.log.*
tmp/
temp/
*.tmp
*.bak

# ============================================
# IDE / EDITOR / OS
# ============================================
# VS Code & PyCharm
.vscode/
.idea/
*.swp
*~

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================
# TESTING & COVERAGE
# ============================================
.pytest_cache/
.coverage
htmlcov/
.tox/
