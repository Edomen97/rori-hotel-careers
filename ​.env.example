# ============================================
# RORI HOTEL CAREERS - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and update the values
# ============================================

# ============================================
# FLASK CONFIGURATION
# ============================================

# Flask Secret Key - Generate a secure key
# You can generate one using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-change-in-production

# Flask Debug Mode (set to False in production)
FLASK_DEBUG=True

# ============================================
# DATABASE CONFIGURATION
# ============================================

# For SQLite (development)
DATABASE_URL=sqlite:///instance/database.db

# For PostgreSQL (production on Render)
# DATABASE_URL=postgresql://username:password@localhost:5432/rori_db

# For MySQL (alternative)
# DATABASE_URL=mysql+pymysql://username:password@localhost/rori_db

# ============================================
# HR ADMIN CREDENTIALS
# ============================================

# Admin username (default: admin)
HR_USERNAME=admin

# Admin password - CHANGE THIS IMMEDIATELY IN PRODUCTION!
# Use a strong password with at least 12 characters
HR_PASSWORD=RoriHR2026

# ============================================
# EMAIL CONFIGURATION (for notifications)
# ============================================

# SMTP Server Settings (Gmail example)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# Email sender credentials
# For Gmail, you need to use an App Password (not your regular password)
# https://support.google.com/accounts/answer/185833
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here

# Default sender email address
MAIL_DEFAULT_SENDER=noreply@rorihotel.com

# Alternative email providers:

# For Outlook/Hotmail:
# MAIL_SERVER=smtp-mail.outlook.com
# MAIL_PORT=587
# MAIL_USE_TLS=true

# For SendGrid:
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key

# For Mailgun:
# MAIL_SERVER=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=postmaster@your-domain.com
# MAIL_PASSWORD=your-mailgun-smtp-password

# ============================================
# UPLOAD CONFIGURATION
# ============================================

# Maximum file upload size (in bytes)
# 10 MB = 10 * 1024 * 1024
MAX_CONTENT_LENGTH=10485760

# Allowed file extensions for resumes
# ALLOWED_EXTENSIONS=pdf,doc,docx

# Allowed image extensions for job banners
# ALLOWED_IMAGE_EXTENSIONS=png,jpg,jpeg,gif,webp

# ============================================
# PWA CONFIGURATION
# ============================================

# Application name for PWA
APP_NAME=Rori Hotel Careers

# Application short name for PWA
APP_SHORT_NAME=Rori Careers

# Theme color
THEME_COLOR=#C5A059

# Background color
BACKGROUND_COLOR=#0B132B

# ============================================
# SECURITY & PERFORMANCE
# ============================================

# Session timeout (in seconds)
# SESSION_TIMEOUT=3600

# Rate limiting (requests per minute)
# RATE_LIMIT=60

# Enable/disable CSRF protection
# CSRF_ENABLED=true

# ============================================
# LOGGING
# ============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
# LOG_FILE=logs/app.log

# ============================================
# FEATURE FLAGS
# ============================================

# Enable email notifications
ENABLE_EMAIL_NOTIFICATIONS=true

# Enable audit logging
ENABLE_AUDIT_LOG=true

# Enable PWA/offline support
ENABLE_PWA=true

# Enable candidate tags
ENABLE_TAGS=true

# ============================================
# RENDER DEPLOYMENT (Optional)
# ============================================

# Set this to True when deploying on Render
# RENDER=true

# Port for the application (Render sets this automatically)
# PORT=10000
 