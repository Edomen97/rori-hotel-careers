# ============================================
# RORI HOTEL CAREERS - ENVIRONMENT VARIABLES
# ============================================
# Usage: Copy this file to '.env' and set your real values.
# NEVER commit the actual '.env' file to Git!
# ============================================

# ============================================
# FLASK CONFIGURATION
# ============================================
# Generate a secure key in terminal using:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-super-secret-key-in-production
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Development (SQLite)
DATABASE_URL=sqlite:///instance/database.db

# Production Example (PostgreSQL - Render)
# DATABASE_URL=postgresql://rori_admin:password@localhost:5432/rori_hotel_db

# ============================================
# HR ADMIN INITIAL CREDENTIALS
# ============================================
HR_USERNAME=admin
HR_PASSWORD=ChangeThisStrongPassword2026!

# ============================================
# EMAIL SMTP CONFIGURATION
# ============================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-digit-app-password
MAIL_DEFAULT_SENDER=noreply@rorihotel.com

# ============================================
# FILE UPLOAD SETTINGS
# ============================================
# Max File Upload Size: 10MB (10 * 1024 * 1024 bytes)
MAX_CONTENT_LENGTH=10485760
UPLOAD_FOLDER=static/uploads/cvs
UPLOAD_FOLDER_JOBS=static/uploads/jobs
ALLOWED_EXTENSIONS=pdf,doc,docx
ALLOWED_IMAGE_EXTENSIONS=png,jpg,jpeg,webp

# ============================================
# PWA & BRANDING CONFIGURATION
# ============================================
APP_NAME=Rori Hotel Careers
APP_SHORT_NAME=Rori Careers
THEME_COLOR=#C5A059
BACKGROUND_COLOR=#0B132B

# ============================================
# SECURITY & FEATURE FLAGS
# ============================================
SESSION_TIMEOUT=3600
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_AUDIT_LOG=true
ENABLE_PWA=true
ENABLE_TAGS=true
LOG_LEVEL=INFO
